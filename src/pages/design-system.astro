    font-size: 16px;
    font-weight: 400;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .ds-specimen__meta {
    @apply flex gap-6 flex-wrap;
  }

  .ds-specimen__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
  }

  .ds-specimen__tag strong {
    color: var(--text-secondary);
  }

  /* Showcase */
  .ds-showcase {
    @apply mb-4;
    padding: 40px;
    border-radius: 0;
    border: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
