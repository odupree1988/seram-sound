    background: var(--accent-subtle);
    color: var(--accent);
    border: 1px solid rgba(72, 200, 180, 0.22);
    border-left: 3px solid var(--accent);
  }

  .ds-section {
    @apply mb-20;
  }

  .ds-section__heading {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    @apply mt-4 mb-4;
  }

  .ds-section__desc {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.8;
    max-width: 640px;
    @apply mb-8;
  }

  .ds-section__subhead {
