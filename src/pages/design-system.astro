---
import BaseLayout from '../layouts/BaseLayout.astro';
import HumanBadge from '../components/ui/HumanBadge.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import { siteConfig } from '../data/siteConfig';
---

<BaseLayout
  title={`Design System | ${siteConfig.metadata.siteName}`}
  description="Internal design system reference for Seram Sound."
  hideStickyCTA={true}
>
  <div class="ds-page">
    <header class="ds-page__header">
      <h1 class="ds-page__title">
        <span class="ds-page__title-solid">DESIGN</span>
        <span class="ds-page__title-outlined">SYSTEM</span>
      </h1>
      <p class="ds-page__subtitle">Seram Sound — Sharp Block + Midnight Teal + Geist</p>
      <span class="ds-page__version">v3.0 — Phase 2 — April 2026</span>
    </header>

    <!-- COLOR TOKENS -->
    <section class="ds-section" aria-labelledby="ds-tokens">
      <span class="section-label" id="ds-tokens">Color Tokens</span>
      <h2 class="ds-section__heading">Midnight Teal Palette</h2>
      <p class="ds-section__desc">All colors defined as CSS custom properties on :root. Overridden via [data-theme="light"]. Components reference tokens, never hardcoded hex.</p>

      <h3 class="ds-section__subhead">Backgrounds</h3>
      <div class="ds-grid ds-grid--4">
        <div class="ds-swatch">
          <div class="ds-swatch__color ds-swatch__color--bg-primary"></div>
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Primary</span>
            <span class="ds-swatch__value">D: #0c0e12 / L: #f0f2f4</span>
            <span class="ds-swatch__token">--bg-primary</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__color ds-swatch__color--bg-secondary"></div>
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Secondary</span>
            <span class="ds-swatch__value">D: #1a1d24 / L: #e2e5e8</span>
            <span class="ds-swatch__token">--bg-secondary</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__color ds-swatch__color--bg-tertiary"></div>
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Tertiary</span>
            <span class="ds-swatch__value">D: #252830 / L: #d4d8dc</span>
            <span class="ds-swatch__token">--bg-tertiary</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__color ds-swatch__color--bg-hover"></div>
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Hover</span>
            <span class="ds-swatch__value">D: #2e323c / L: #c8ccd2</span>
            <span class="ds-swatch__token">--bg-hover</span>
          </div>
        </div>
      </div>

      <h3 class="ds-section__subhead">Text</h3>
      <div class="ds-grid ds-grid--3">
        <div class="ds-swatch">
          <div class="ds-swatch__color ds-swatch__color--text-demo">
            <span class="ds-swatch__text-sample ds-swatch__text-sample--primary">Aa</span>
          </div>
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Primary</span>
            <span class="ds-swatch__value">D: #e4e8ec / L: #141820</span>
            <span class="ds-swatch__token">--text-primary</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__color ds-swatch__color--text-demo">
            <span class="ds-swatch__text-sample ds-swatch__text-sample--secondary">Aa</span>
          </div>
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Secondary</span>
            <span class="ds-swatch__value">D: #8c94a0 / L: #4a5260</span>
            <span class="ds-swatch__token">--text-secondary</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__color ds-swatch__color--text-demo">
            <span class="ds-swatch__text-sample ds-swatch__text-sample--tertiary">Aa</span>
          </div>
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Tertiary</span>
            <span class="ds-swatch__value">D: #5c6370 / L: #7a8290</span>
            <span class="ds-swatch__token">--text-tertiary</span>
          </div>
        </div>
      </div>

      <h3 class="ds-section__subhead">Accent</h3>
      <div class="ds-grid ds-grid--4">
        <div class="ds-swatch">
          <div class="ds-swatch__color ds-swatch__color--accent"></div>
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Accent</span>
            <span class="ds-swatch__value">D: #48c8b4 / L: #1e8273</span>
            <span class="ds-swatch__token">--accent</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__color ds-swatch__color--accent-hover"></div>
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Accent Hover</span>
            <span class="ds-swatch__value">D: #36a896 / L: #166b5e</span>
            <span class="ds-swatch__token">--accent-hover</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__color ds-swatch__color--accent-subtle"></div>
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Accent Subtle</span>
            <span class="ds-swatch__value">10% opacity</span>
            <span class="ds-swatch__token">--accent-subtle</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__color ds-swatch__color--accent-glow"></div>
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Accent Glow</span>
            <span class="ds-swatch__value">6% opacity</span>
            <span class="ds-swatch__token">--accent-glow</span>
          </div>
        </div>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- SURFACE DEPTH -->
    <section class="ds-section" aria-labelledby="ds-surfaces">
      <span class="section-label" id="ds-surfaces">Surface Depth</span>
      <h2 class="ds-section__heading">Elevation System</h2>
      <p class="ds-section__desc">Three surface levels create visual depth. Sections alternate between surface-0 and surface-1. Cards and panels sit on surface-1. Modals and tooltips on surface-2.</p>

      <div class="ds-grid ds-grid--3">
        <div class="ds-swatch">
          <div class="ds-swatch__color" style="background: var(--surface-0); height: 80px;"></div>
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Surface 0 (Deepest)</span>
            <span class="ds-swatch__value">Page background</span>
            <span class="ds-swatch__token">--surface-0</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__color" style="background: var(--surface-1); height: 80px;"></div>
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Surface 1 (Cards)</span>
            <span class="ds-swatch__value">Panels, alternating sections</span>
            <span class="ds-swatch__token">--surface-1</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__color" style="background: var(--surface-2); height: 80px;"></div>
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Surface 2 (Elevated)</span>
            <span class="ds-swatch__value">Modals, tooltips</span>
            <span class="ds-swatch__token">--surface-2</span>
          </div>
        </div>
      </div>

      <h3 class="ds-section__subhead">Shadow Scale</h3>
      <div class="ds-grid ds-grid--3">
        <div class="ds-showcase ds-showcase--dark" style="padding: 24px;">
          <div class="ds-shadow-demo ds-shadow-demo--card"></div>
          <span class="ds-showcase__label" style="margin-bottom: 0; margin-top: 12px; border-bottom: none;">--shadow-card</span>
        </div>
        <div class="ds-showcase ds-showcase--dark" style="padding: 24px;">
          <div class="ds-shadow-demo ds-shadow-demo--elevated"></div>
          <span class="ds-showcase__label" style="margin-bottom: 0; margin-top: 12px; border-bottom: none;">--shadow-elevated</span>
        </div>
        <div class="ds-showcase ds-showcase--dark" style="padding: 24px;">
          <div class="ds-shadow-demo ds-shadow-demo--glow"></div>
          <span class="ds-showcase__label" style="margin-bottom: 0; margin-top: 12px; border-bottom: none;">--shadow-glow</span>
        </div>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- GLASSMORPHISM -->
    <section class="ds-section" aria-labelledby="ds-glass">
      <span class="section-label" id="ds-glass">Glassmorphism</span>
      <h2 class="ds-section__heading">Glass Surfaces</h2>
      <p class="ds-section__desc">Used on the navbar (on scroll) and overlays. Combines backdrop-blur, reduced-opacity background, and subtle borders.</p>

      <div class="ds-showcase ds-showcase--dark">
        <span class="ds-showcase__label">Glass panel — navbar on scroll</span>
        <div class="ds-glass-demo">
          <span class="ds-glass-demo__text">backdrop-filter: blur(var(--glass-blur)) saturate(180%)</span>
          <span class="ds-glass-demo__text">background: var(--glass-bg)</span>
          <span class="ds-glass-demo__text">border: 1px solid var(--glass-border)</span>
        </div>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- MOTION PRESETS -->
    <section class="ds-section" aria-labelledby="ds-motion">
      <span class="section-label" id="ds-motion">Motion</span>
      <h2 class="ds-section__heading">Animation Presets</h2>
      <p class="ds-section__desc">Centralized timing and easing tokens for consistent motion across all components. Scroll reveals, hero entrances, and hover transitions all reference these presets.</p>

      <div class="ds-grid ds-grid--4">
        <div class="ds-swatch">
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Reveal Duration</span>
            <span class="ds-swatch__value">600ms</span>
            <span class="ds-swatch__token">--duration-reveal</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Stagger Delay</span>
            <span class="ds-swatch__value">80ms per child</span>
            <span class="ds-swatch__token">--stagger-delay</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Ease Out Expo</span>
            <span class="ds-swatch__value">cubic-bezier(0.16, 1, 0.3, 1)</span>
            <span class="ds-swatch__token">--ease-out-expo</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Ease Out Quart</span>
            <span class="ds-swatch__value">cubic-bezier(0.25, 1, 0.5, 1)</span>
            <span class="ds-swatch__token">--ease-out-quart</span>
          </div>
        </div>
      </div>

      <h3 class="ds-section__subhead">Scroll Reveal</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">fade-in → fade-in--visible (Intersection Observer)</span>
        <p class="ds-showcase__note">Elements start at opacity: 0, translateY(24px). On viewport entry, they animate to final position using --ease-out-expo over --duration-reveal. Stagger via --reveal-delay custom property per element.</p>
      </div>

      <h3 class="ds-section__subhead">Hero Entrance</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">Staggered sequence: label → name → divider → intro → CTAs → pills → badge</span>
        <p class="ds-showcase__note">Each hero child animates in with hero-reveal-up (slide + fade). The hero name uses hero-scale-in (scale 0.96 → 1). DAW visual fades in at 700ms. Scroll indicator at 1200ms. A radial teal glow (--hero-glow) pulses subtly behind the headline.</p>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- TYPOGRAPHY -->
    <section class="ds-section" aria-labelledby="ds-typography">
      <span class="section-label" id="ds-typography">Typography</span>
      <h2 class="ds-section__heading">Type Scale</h2>
      <p class="ds-section__desc">Two font families. Geist handles display, headings, and body. Geist Mono handles labels, CTAs, pills, and metadata.</p>

      <div class="ds-specimen">
        <div class="ds-specimen__sample ds-specimen__sample--display">SERAM SOUND</div>
        <div class="ds-specimen__meta">
          <span class="ds-specimen__tag"><strong>Family:</strong> Geist</span>
          <span class="ds-specimen__tag"><strong>Token:</strong> --font-display</span>
          <span class="ds-specimen__tag"><strong>Weights:</strong> 400-800</span>
        </div>
      </div>

      <div class="ds-specimen">
        <div class="ds-specimen__sample ds-specimen__sample--mono">Original music for short films, branded content, and digital media. Every note composed by hand — no AI, no stock libraries, no shortcuts.</div>
        <div class="ds-specimen__meta">
          <span class="ds-specimen__tag"><strong>Family:</strong> Geist Mono</span>
          <span class="ds-specimen__tag"><strong>Token:</strong> --font-mono</span>
          <span class="ds-specimen__tag"><strong>Weights:</strong> 300-500</span>
        </div>
      </div>

      <div class="ds-specimen">
        <div class="ds-specimen__sample ds-specimen__sample--body">I compose original, handcrafted scores for short films, branded content, and digital media. With over ten years of professional music production experience, I bring a deep understanding of how music shapes story, pacing, and emotion.</div>
        <div class="ds-specimen__meta">
          <span class="ds-specimen__tag"><strong>Family:</strong> Geist</span>
          <span class="ds-specimen__tag"><strong>Token:</strong> --font-body</span>
          <span class="ds-specimen__tag"><strong>Weights:</strong> 400-500</span>
        </div>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- CTAs -->
    <section class="ds-section" aria-labelledby="ds-ctas">
      <span class="section-label" id="ds-ctas">Sharp Block CTAs</span>
      <h2 class="ds-section__heading">Button & CTA System</h2>
      <p class="ds-section__desc">Zero border-radius across all interactive elements. The 3px left accent bar is the primary visual signature.</p>

      <h3 class="ds-section__subhead">Primary CTA</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">.btn--primary</span>
        <a href="#" class="btn--primary" onclick="event.preventDefault()">
          Hear my work
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
        </a>
      </div>

      <h3 class="ds-section__subhead">Secondary CTA</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">.btn--secondary</span>
        <a href="#" class="btn--secondary" onclick="event.preventDefault()">
          Get a quote
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <h3 class="ds-section__subhead">Nav Pill</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">.btn--nav</span>
        <a href="#" class="btn--nav" onclick="event.preventDefault()">Contact</a>
      </div>

      <h3 class="ds-section__subhead">Sticky / Floating CTA</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">.btn--sticky</span>
        <a href="#" class="btn--sticky" onclick="event.preventDefault()">
          Get a Quote
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
        </a>
      </div>

      <h3 class="ds-section__subhead">All CTAs Together</h3>
      <div class="ds-showcase ds-showcase--dark">
        <span class="ds-showcase__label">Full CTA row — as it appears in the hero</span>
        <div class="ds-showcase__row">
          <a href="#" class="btn--primary" onclick="event.preventDefault()">
            Hear my work
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </a>
          <span class="ds-showcase__divider" aria-hidden="true"></span>
          <a href="#" class="btn--secondary" onclick="event.preventDefault()">
            Get a quote
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- COMPONENTS -->
    <section class="ds-section" aria-labelledby="ds-components">
      <span class="section-label" id="ds-components">Components</span>
      <h2 class="ds-section__heading">UI Components</h2>

      <h3 class="ds-section__subhead">Pills / Tags</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">.pill</span>
        <div class="ds-showcase__pills">
          {siteConfig.serviceTypes.slice(0, 6).map((service) => (
            <span class="pill">{service}</span>
          ))}
        </div>
      </div>

      <h3 class="ds-section__subhead">Human-Composed Badge</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">.human-badge</span>
        <HumanBadge />
      </div>

      <h3 class="ds-section__subhead">Section Labels</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">.section-label + .section-heading</span>
        <div class="ds-showcase__section-demo">
          <span class="section-label">Portfolio</span>
          <span class="section-heading">Featured Work</span>
        </div>
      </div>

      <h3 class="ds-section__subhead">Theme Toggle</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">.theme-toggle — square track + square thumb</span>
        <div class="ds-showcase__toggle-row">
          <ThemeToggle />
          <span class="ds-showcase__toggle-note">Square track + square thumb to match Sharp Block system</span>
        </div>
      </div>

      <h3 class="ds-section__subhead">Glass Navbar Preview</h3>
      <div class="ds-showcase__navbar">
        <div class="ds-showcase__navbar-inner">
          <div class="ds-showcase__navbar-brand">
            <span class="ds-showcase__navbar-dot" aria-hidden="true"></span>
            <span class="ds-showcase__navbar-name">seram.sound</span>
          </div>
          <div class="ds-showcase__navbar-links">
            <span class="ds-showcase__navbar-link">Portfolio</span>
            <span class="ds-showcase__navbar-link">Services</span>
            <span class="ds-showcase__navbar-link">About</span>
            <a href="#" class="btn--nav" onclick="event.preventDefault()">Get a Quote</a>
          </div>
        </div>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- PATTERNS -->
    <section class="ds-section" aria-labelledby="ds-patterns">
      <span class="section-label" id="ds-patterns">Patterns</span>
      <h2 class="ds-section__heading">Visual Patterns</h2>

      <h3 class="ds-section__subhead">Hero Name Treatment</h3>
      <div class="ds-showcase ds-showcase--dark">
        <div class="ds-hero-name-demo">
          <span class="ds-hero-name-demo__solid">SERAM</span>
          <span class="ds-hero-name-demo__outlined">SOUND</span>
        </div>
        <p class="ds-showcase__note">Geist 800. First line solid, second line outlined. clamp(48px, 8vw, 96px) for responsive scaling.</p>
      </div>

      <h3 class="ds-section__subhead">Card Surface</h3>
      <div class="ds-showcase ds-showcase--dark">
        <div class="ds-card-demo">
          <div class="ds-card-demo__accent" aria-hidden="true"></div>
          <div class="ds-card-demo__glow" aria-hidden="true"></div>
          <div class="ds-card-demo__body">
            <span class="ds-card-demo__title">Portfolio Card</span>
            <span class="ds-card-demo__genre">Short Film — Before / After</span>
            <div class="ds-card-demo__waveform" aria-hidden="true">
              {[5,9,15,11,20,14,22,18,7,16,24,12,18,9,14,20,16,7,12,22,16,9,18,14,7].map((h, i) => (
                <span class="ds-card-demo__bar" style={`height: ${h}px; opacity: ${i < 13 ? 0.85 : 0.25}`}></span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <h3 class="ds-section__subhead">Design Motif: The Left Bar</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">The 3px left accent bar is the unifying visual motif</span>
        <div class="ds-showcase__motif-row">
          <a href="#" class="btn--primary" onclick="event.preventDefault()">
            Primary CTA
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </a>
          <span class="pill">Tag / Pill</span>
          <HumanBadge />
          <a href="#" class="btn--nav" onclick="event.preventDefault()">Nav Pill</a>
        </div>
        <p class="ds-showcase__note">Every bordered element carries the left accent bar — instant visual cohesion.</p>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- PHASE 2 — IMAGE FILTERS -->
    <section class="ds-section" aria-labelledby="ds-img-filters">
      <span class="section-label" id="ds-img-filters">Image Filters</span>
      <h2 class="ds-section__heading">Theme-Aware Photo Treatment</h2>
      <p class="ds-section__desc">CSS filter tokens applied to images per theme. Ensures photos integrate with the dark/light palette without appearing washed out or overpowering.</p>

      <div class="ds-grid ds-grid--4">
        <div class="ds-swatch">
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Hero Image</span>
            <span class="ds-swatch__value">D: saturate(0.5) brightness(0.55)<br/>L: saturate(0.6) brightness(0.45)</span>
            <span class="ds-swatch__token">--hero-img-filter</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Card Image</span>
            <span class="ds-swatch__value">D: saturate(0.7) brightness(0.8)<br/>L: saturate(0.85) brightness(0.95)</span>
            <span class="ds-swatch__token">--card-img-filter</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Card Hover</span>
            <span class="ds-swatch__value">D: saturate(0.9) brightness(0.9)<br/>L: saturate(1) brightness(1)</span>
            <span class="ds-swatch__token">--card-img-hover-filter</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">About Image</span>
            <span class="ds-swatch__value">D: saturate(0.6) brightness(0.85)<br/>L: saturate(0.7) brightness(0.9)</span>
            <span class="ds-swatch__token">--about-img-filter</span>
          </div>
        </div>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- PHASE 2 — HERO OVERLAYS -->
    <section class="ds-section" aria-labelledby="ds-hero-overlays">
      <span class="section-label" id="ds-hero-overlays">Hero Overlays</span>
      <h2 class="ds-section__heading">Gradient Overlay Stack</h2>
      <p class="ds-section__desc">Three overlay layers create atmospheric depth over background images: image filter, vertical gradient, and edge vignette.</p>

      <div class="ds-grid ds-grid--3">
        <div class="ds-swatch">
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Overlay Start</span>
            <span class="ds-swatch__value">D: rgba(12,14,18,0.15)<br/>L: rgba(240,242,244,0.0)</span>
            <span class="ds-swatch__token">--hero-overlay-start</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Overlay Mid</span>
            <span class="ds-swatch__value">D: rgba(12,14,18,0.55)<br/>L: rgba(240,242,244,0.55)</span>
            <span class="ds-swatch__token">--hero-overlay-mid</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Overlay End</span>
            <span class="ds-swatch__value">D: rgba(12,14,18,0.97)<br/>L: rgba(240,242,244,0.98)</span>
            <span class="ds-swatch__token">--hero-overlay-end</span>
          </div>
        </div>
      </div>

      <h3 class="ds-section__subhead">Layer Stack</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">Waveform (z-1) → glow (z-0) → content (z-10)</span>
        <p class="ds-showcase__note">hero__glow (radial teal, pulsing) → hero__waveform (260 bars, 180px tall, 7% opacity dark / 11% light) → hero__content (all text, z-index 10)</p>
      </div>

      <h3 class="ds-section__subhead">Waveform Edge Fade</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">Pipeline note: mask-image must be inline</span>
        <p class="ds-showcase__note">The mask-image and -webkit-mask-image properties are stripped by the Tailwind/Vite CSS processing pipeline when placed in .css files. Apply them as inline style attributes directly on waveform elements: style="mask-image: linear-gradient(90deg, transparent 0%, black 8%, black 92%, transparent 100%); -webkit-mask-image: ..."</p>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- PHASE 2 — NOISE TEXTURE -->
    <section class="ds-section" aria-labelledby="ds-noise">
      <span class="section-label" id="ds-noise">Noise Texture</span>
      <h2 class="ds-section__heading">Film Grain Overlay</h2>
      <p class="ds-section__desc">A global body::after pseudo-element using SVG feTurbulence fractalNoise. Fixed position, pointer-events: none, z-index: 9999. Opacity controlled by token.</p>

      <div class="ds-grid ds-grid--3">
        <div class="ds-swatch">
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Noise Opacity</span>
            <span class="ds-swatch__value">D: 0.03 / L: 0.015</span>
            <span class="ds-swatch__token">--noise-opacity</span>
          </div>
        </div>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- PHASE 2 — MARQUEE -->
    <section class="ds-section" aria-labelledby="ds-marquee">
      <span class="section-label" id="ds-marquee">Marquee</span>
      <h2 class="ds-section__heading">Two-Row Carousel</h2>
      <p class="ds-section__desc">Two infinite-scrolling rows of service type pills. Row 1 scrolls left, Row 2 scrolls right. Pauses on section hover. Edge fade masks on both sides.</p>

      <div class="ds-grid ds-grid--3">
        <div class="ds-swatch">
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Row 1 Speed</span>
            <span class="ds-swatch__value">50s linear infinite</span>
            <span class="ds-swatch__token">--marquee-speed-row1</span>
          </div>
        </div>
        <div class="ds-swatch">
          <div class="ds-swatch__info">
            <span class="ds-swatch__name">Row 2 Speed</span>
            <span class="ds-swatch__value">55s linear infinite (reverse)</span>
            <span class="ds-swatch__token">--marquee-speed-row2</span>
          </div>
        </div>
      </div>

      <h3 class="ds-section__subhead">Behavior</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">Interaction model</span>
        <p class="ds-showcase__note">Items duplicated 4x for seamless loop. Each item is a bordered pill with music note icon. Hover: text/icon go teal, border goes accent. Section hover pauses all animation. Respects prefers-reduced-motion.</p>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- PHASE 2 — CASE STUDY CARD -->
    <section class="ds-section" aria-labelledby="ds-case-card">
      <span class="section-label" id="ds-case-card">Case Study Card</span>
      <h2 class="ds-section__heading">Portfolio Card Pattern</h2>
      <p class="ds-section__desc">Image header (200px) with filter and bottom-fade overlay. Accent line hidden by default, visible on hover. Audio player with left-bar border, waveform bars, and progress slider.</p>

      <h3 class="ds-section__subhead">Hover State</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">Card interaction</span>
        <p class="ds-showcase__note">Card: translateY(-6px), shadow-elevated + shadow-glow, border teal. Image: scale(1.05), filter transitions to hover variant. Accent line fades in (opacity 0 → 1).</p>
      </div>

      <h3 class="ds-section__subhead">Audio Player</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">Inline player anatomy</span>
        <p class="ds-showcase__note">Left-bar accent border (3px). Square play button with accent-subtle bg. SVG waveform bars (2px wide, ~48 bars, sine-curve height). Progress slider with scrub handle. Timestamp in mono 10px.</p>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- PHASE 2 — PHILOSOPHY QUOTE -->
    <section class="ds-section" aria-labelledby="ds-philosophy">
      <span class="section-label" id="ds-philosophy">Philosophy Quote</span>
      <h2 class="ds-section__heading">Blockquote Pattern</h2>
      <p class="ds-section__desc">Full-width surface-1 section with centered quote. Large decorative opening mark (120px, accent, 10% opacity). Quote in --font-body italic 22px. Attribution flanked by teal dashes.</p>

      <div class="ds-showcase">
        <span class="ds-showcase__label">Composition</span>
        <p class="ds-showcase__note">Accent bar (3px) centered at top. Background waveform bars (static, 3% opacity) for texture. Quote mark + blockquote + attribution row.</p>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- PHASE 2 — ABOUT SPLIT LAYOUT -->
    <section class="ds-section" aria-labelledby="ds-about-layout">
      <span class="section-label" id="ds-about-layout">About Layout</span>
      <h2 class="ds-section__heading">Split Layout Pattern</h2>
      <p class="ds-section__desc">Two-column grid (1fr 1fr, gap 64px). Left: image with about-img-filter, bottom gradient overlay, glassmorphic badge. Right: heading, body text, 3-column stat callouts, CTA.</p>

      <h3 class="ds-section__subhead">Stat Callouts</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">3-column grid</span>
        <p class="ds-showcase__note">Each stat: surface-1 bg, left-bar accent, number in accent color (28px, weight 800), label in mono uppercase (10px). Example: "10+" / "Years Experience".</p>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- PHASE 2 — PROCESS TIMELINE -->
    <section class="ds-section" aria-labelledby="ds-timeline">
      <span class="section-label" id="ds-timeline">Process Timeline</span>
      <h2 class="ds-section__heading">Timeline Pattern</h2>
      <p class="ds-section__desc">Vertical connecting line (1px, accent gradient fading to border-subtle). Step numbers in 48x48 square badges with left-bar accent. Content alongside with display font title and body font description.</p>

      <div class="ds-showcase">
        <span class="ds-showcase__label">Vertical line positioning</span>
        <p class="ds-showcase__note">Line at left: 23px via timeline::before pseudo-element. Gradient: accent → border-subtle (80%) → transparent. Step badges sit over line (z-index: 2).</p>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- PHASE 2 — FOOTER LAYOUT -->
    <section class="ds-section" aria-labelledby="ds-footer">
      <span class="section-label" id="ds-footer">Footer Layout</span>
      <h2 class="ds-section__heading">Four-Column Footer</h2>
      <p class="ds-section__desc">Column 1: brand + tagline + badge. Column 2: navigation links. Column 3: service links. Column 4: email + social icons (square bordered, teal hover). Bottom bar with copyright and legal links.</p>

      <div class="ds-showcase">
        <span class="ds-showcase__label">Grid structure</span>
        <p class="ds-showcase__note">Desktop: 2fr 1fr 1fr 1fr. Tablet: 2-col. Mobile: single column. Social icons: 36px square, 1px border, teal on hover.</p>
      </div>
    </section>

    <div class="ds-divider" aria-hidden="true"></div>

    <!-- PHASE 2 — TYPOGRAPHY USAGE RULES -->
    <section class="ds-section" aria-labelledby="ds-type-rules">
      <span class="section-label" id="ds-type-rules">Typography Rules</span>
      <h2 class="ds-section__heading">Mono vs Sans Usage</h2>
      <p class="ds-section__desc">Clear rules for when to use each font family across the site.</p>

      <h3 class="ds-section__subhead">--font-mono (Geist Mono)</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">UI elements only</span>
        <p class="ds-showcase__note">Navigation labels, section labels, CTA button text, timestamps/metadata, badges, genre tags, form field labels, the seram.sound wordmark, token names.</p>
      </div>

      <h3 class="ds-section__subhead">--font-body (Geist Sans)</h3>
      <div class="ds-showcase">
        <span class="ds-showcase__label">All content text</span>
        <p class="ds-showcase__note">Paragraph text, card descriptions, section descriptions, about page body, process step descriptions, contact subtext, any content longer than one line.</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  @reference "tailwindcss";
  .ds-page {
    @apply mx-auto pt-32 pb-24 px-6 lg:px-12;
    max-width: 1200px;
  }

  .ds-page__header {
    @apply mb-20;
  }

  .ds-page__title {
    @apply leading-none;
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 800;
    letter-spacing: -1.5px;
  }

  .ds-page__title-solid {
    @apply block;
    color: var(--text-primary);
  }

  .ds-page__title-outlined {
    @apply block;
    -webkit-text-stroke: 1.5px var(--text-secondary);
    color: transparent;
  }

  .ds-page__subtitle {
