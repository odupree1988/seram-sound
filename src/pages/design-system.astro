  }

  .ds-grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .ds-grid--4 {
    grid-template-columns: repeat(4, 1fr);
  }

  @media (max-width: 768px) {
    .ds-grid--3,
    .ds-grid--4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Swatches */
  .ds-swatch {
    @apply overflow-hidden;
    border-radius: 0;
    border: 1px solid var(--border-subtle);
  }

  .ds-swatch__color {
    @apply flex items-center justify-center;
    height: 72px;
  }

  .ds-swatch__color--bg-primary { background: var(--bg-primary); }
  .ds-swatch__color--bg-secondary { background: var(--bg-secondary); }
  .ds-swatch__color--bg-tertiary { background: var(--bg-tertiary); }
  .ds-swatch__color--bg-hover { background: var(--bg-hover); }
  .ds-swatch__color--text-demo { background: var(--bg-secondary); }
  .ds-swatch__color--accent { background: var(--accent); }
  .ds-swatch__color--accent-hover { background: var(--accent-hover); }
  .ds-swatch__color--accent-subtle {
    background: var(--accent-subtle);
    border: 1px dashed var(--accent);
  }
  .ds-swatch__color--accent-glow {
    background: var(--accent-glow);
    border: 1px dashed var(--border-hover);
  }

  .ds-swatch__text-sample {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 700;
  }

  .ds-swatch__text-sample--primary { color: var(--text-primary); }
  .ds-swatch__text-sample--secondary { color: var(--text-secondary); }
  .ds-swatch__text-sample--tertiary { color: var(--text-tertiary); }

  .ds-swatch__info {
    @apply flex flex-col gap-1 p-3;
    background: var(--bg-secondary);
  }

  .ds-swatch__name {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-primary);
  }

  .ds-swatch__value {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-tertiary);
  }

  .ds-swatch__token {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent);
  }

  /* Specimens */
  .ds-specimen {
    @apply mb-4;
    padding: 32px;
    border-radius: 0;
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--accent);
    background: var(--bg-secondary);
  }

  .ds-specimen__sample {
    @apply mb-4;
    line-height: 1.2;
  }

  .ds-specimen__sample--display {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 800;
    letter-spacing: -1.5px;
