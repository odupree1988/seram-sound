---
import './StickyGetQuote.css';
---

<div class="sticky-cta" id="sticky-cta" aria-hidden="true">
  <a href="/contact" class="btn--sticky">
    Get a Quote
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
  </a>
</div>

<script>
  let stickyCta: HTMLElement | null = null;
  let scrollBound = false;

  function onScroll() {
    const threshold = window.innerHeight * 0.8;
    if (window.scrollY > threshold) {
      stickyCta?.classList.add('sticky-cta--visible');
      stickyCta?.setAttribute('aria-hidden', 'false');
    } else {
      stickyCta?.classList.remove('sticky-cta--visible');
      stickyCta?.setAttribute('aria-hidden', 'true');
    }
  }

  function initStickyCta() {
    // Re-grab the element each navigation (it may be absent on pages that
    // pass hideStickyCTA, and is a fresh node when present).
    stickyCta = document.getElementById('sticky-cta');
    onScroll();

    if (!scrollBound) {
      scrollBound = true;
      window.addEventListener('scroll', onScroll);
    }
  }

  document.addEventListener('astro:page-load', initStickyCta);
</script>
