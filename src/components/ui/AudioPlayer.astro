---
import './AudioPlayer.css';

interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<div class="audio-player" data-audio-player data-src={src}>
  <button class="audio-player__play" aria-label={`Play ${title}`}>
    <svg class="audio-player__icon--play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <polygon points="5,3 19,12 5,21"/>
    </svg>
    <svg class="audio-player__icon--pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <rect x="5" y="3" width="4" height="18"/>
      <rect x="15" y="3" width="4" height="18"/>
    </svg>
  </button>

  <div class="audio-player__info">
    <span class="audio-player__title">{title}</span>
    <div class="audio-player__progress-wrapper">
      <div class="audio-player__progress" role="progressbar" aria-valuenow={0} aria-valuemin={0} aria-valuemax={100}>
        <div class="audio-player__progress-bar"></div>
      </div>
    </div>
  </div>

  <span class="audio-player__time">0:00 / 0:00</span>
</div>

<script>
  document.querySelectorAll('[data-audio-player]').forEach((player) => {
    const el = player as HTMLElement;
    const src = el.dataset.src;
    const playBtn = el.querySelector('.audio-player__play') as HTMLButtonElement;
    const progressBar = el.querySelector('.audio-player__progress-bar') as HTMLElement;
    const progressWrapper = el.querySelector('.audio-player__progress') as HTMLElement;
    const timeDisplay = el.querySelector('.audio-player__time') as HTMLElement;

    let audio: HTMLAudioElement | null = null;
    let isPlaying = false;

    function formatTime(seconds: number): string {
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m}:${s.toString().padStart(2, '0')}`;
    }

    playBtn?.addEventListener('click', () => {
      if (!audio && src) {
        audio = new Audio(src);
        audio.addEventListener('timeupdate', () => {
          if (!audio) return;
          const pct = (audio.currentTime / audio.duration) * 100;
          progressBar.style.width = `${pct}%`;
          timeDisplay.textContent = `${formatTime(audio.currentTime)} / ${formatTime(audio.duration || 0)}`;
        });
        audio.addEventListener('ended', () => {
          isPlaying = false;
          el.classList.remove('audio-player--playing');
          progressBar.style.width = '0%';
        });
      }

      if (!audio) return;

      if (isPlaying) {
        audio.pause();
        isPlaying = false;
        el.classList.remove('audio-player--playing');
      } else {
        audio.play();
        isPlaying = true;
        el.classList.add('audio-player--playing');
      }
    });

    progressWrapper?.addEventListener('click', (e: MouseEvent) => {
      if (!audio || !audio.duration) return;
      const rect = progressWrapper.getBoundingClientRect();
      const pct = (e.clientX - rect.left) / rect.width;
      audio.currentTime = pct * audio.duration;
    });
  });
</script>
