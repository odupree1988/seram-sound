---
import './WorkCard.css';

interface Props {
  title: string;
  genre: string;
  description: string;
  audioSrc: string;
}

const { title, genre, description, audioSrc } = Astro.props;

const waveformBars = [5, 9, 15, 11, 20, 14, 22, 18, 7, 16, 24, 12, 18, 9, 14, 20, 16, 7, 12, 22, 16, 9, 18, 14, 7];
---

<article class="work-card">
  <div class="work-card__accent" aria-hidden="true"></div>
  <div class="work-card__glow" aria-hidden="true"></div>
  <div class="work-card__body">
    <div class="work-card__visual">
      <div class="work-card__waveform" aria-hidden="true">
        {waveformBars.map((h) => (
          <span class="work-card__bar" style={`height: ${h}px`}></span>
        ))}
      </div>
    </div>

    <span class="work-card__genre">{genre}</span>
    <h3 class="work-card__title">{title}</h3>
    <p class="work-card__desc">{description}</p>

    {audioSrc ? (
      <div class="work-card__player" data-workcard-player data-audio-src={audioSrc} data-track-title={title}>
        <button class="work-card__play" aria-label={`Play ${title}`}>
          <svg class="work-card__icon--play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <polygon points="5,3 19,12 5,21"/>
          </svg>
          <svg class="work-card__icon--pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <rect x="5" y="3" width="4" height="18"/>
            <rect x="15" y="3" width="4" height="18"/>
          </svg>
        </button>
        <div
          class="work-card__progress"
          role="slider"
          tabindex="0"
          aria-label={`Seek ${title}`}
          aria-valuemin={0}
          aria-valuemax={100}
          aria-valuenow={0}
          aria-valuetext="0:00"
        >
          <div class="work-card__progress-bar"></div>
        </div>
        <span class="work-card__time">0:00</span>
      </div>
    ) : (
      <div class="work-card__player work-card__player--disabled">
        <span class="work-card__coming-soon">Coming soon</span>
      </div>
    )}
  </div>
</article>

<script>
  // Shared registry: when one player starts, stop all others
  const allPlayers: Array<{ stop: () => void }> = [];

  document.querySelectorAll('[data-workcard-player]').forEach((player) => {
    const el = player as HTMLElement;
    const src = el.dataset.audioSrc;
    const trackTitle = el.dataset.trackTitle;
    const playBtn = el.querySelector('.work-card__play') as HTMLButtonElement;
    const progressBar = el.querySelector('.work-card__progress-bar') as HTMLElement;
    const progressSlider = el.querySelector('.work-card__progress') as HTMLElement;
    const timeDisplay = el.querySelector('.work-card__time') as HTMLElement;

    let audio: HTMLAudioElement | null = null;
    let isPlaying = false;
    let isDragging = false;

    function stopAndReset() {
      if (!audio) return;
      audio.pause();
      audio.currentTime = 0;
      isPlaying = false;
      el.classList.remove('work-card__player--playing');
      updateProgress(0);
      timeDisplay.textContent = formatTime(audio.duration || 0);
      updateAriaLabel();
    }

    allPlayers.push({ stop: stopAndReset });

    function updateProgress(pct: number) {
      progressBar.style.width = `${pct}%`;
      progressSlider.style.setProperty('--progress-pct', `${pct}%`);
      progressSlider.setAttribute('aria-valuenow', String(Math.round(pct)));
    }

    function formatTime(seconds: number): string {
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m}:${s.toString().padStart(2, '0')}`;
    }

    function updateAriaLabel() {
      playBtn.setAttribute('aria-label', isPlaying ? `Pause ${trackTitle}` : `Play ${trackTitle}`);
    }

    function seekTo(fraction: number) {
      if (!audio || !audio.duration) return;
      audio.currentTime = Math.max(0, Math.min(fraction, 1)) * audio.duration;
    }

    function initAudio() {
      if (audio || !src) return;
      audio = new Audio(src);
      audio.addEventListener('loadedmetadata', () => {
        if (!audio) return;
        timeDisplay.textContent = formatTime(audio.duration);
        progressSlider.setAttribute('aria-valuetext', `0:00 of ${formatTime(audio.duration)}`);
      });
      audio.addEventListener('timeupdate', () => {
        if (!audio || isDragging) return;
        const pct = (audio.currentTime / audio.duration) * 100;
        updateProgress(pct);
        timeDisplay.textContent = formatTime(audio.currentTime);
        progressSlider.setAttribute('aria-valuetext', `${formatTime(audio.currentTime)} of ${formatTime(audio.duration)}`);
      });
      audio.addEventListener('ended', () => {
        isPlaying = false;
        el.classList.remove('work-card__player--playing');
        updateProgress(0);
        updateAriaLabel();
      });
    }

    function togglePlayPause() {
      initAudio();
      if (!audio) return;
      if (isPlaying) {
        audio.pause();
        isPlaying = false;
        el.classList.remove('work-card__player--playing');
      } else {
        // Stop all other players first
        allPlayers.forEach((p) => { if (p.stop !== stopAndReset) p.stop(); });
        audio.play();
        isPlaying = true;
        el.classList.add('work-card__player--playing');
      }
      updateAriaLabel();
    }

    playBtn?.addEventListener('click', togglePlayPause);

    // Keyboard support for progress slider
    progressSlider?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (!audio || !audio.duration) return;
      const step = 5;
      switch (e.key) {
        case 'ArrowRight':
        case 'ArrowUp':
          e.preventDefault();
          seekTo((audio.currentTime + step) / audio.duration);
          break;
        case 'ArrowLeft':
        case 'ArrowDown':
          e.preventDefault();
          seekTo((audio.currentTime - step) / audio.duration);
          break;
        case 'Home':
          e.preventDefault();
          seekTo(0);
          break;
        case 'End':
          e.preventDefault();
          seekTo(1);
          break;
      }
    });

    // --- Click & drag to seek ---
    function getFraction(clientX: number): number {
      const rect = progressSlider.getBoundingClientRect();
      return Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
    }

    function onDragMove(clientX: number) {
      const frac = getFraction(clientX);
      updateProgress(frac * 100);
      if (audio && audio.duration) {
        timeDisplay.textContent = formatTime(frac * audio.duration);
      }
    }

    function onDragEnd(clientX: number) {
      isDragging = false;
      progressSlider.classList.remove('work-card__progress--dragging');
      const frac = getFraction(clientX);
      seekTo(frac);
      document.removeEventListener('mousemove', handleMouseMove);
      document.removeEventListener('mouseup', handleMouseUp);
      document.removeEventListener('touchmove', handleTouchMove);
      document.removeEventListener('touchend', handleTouchEnd);
    }

    function handleMouseMove(e: MouseEvent) { onDragMove(e.clientX); }
    function handleMouseUp(e: MouseEvent) { onDragEnd(e.clientX); }
    function handleTouchMove(e: TouchEvent) { e.preventDefault(); onDragMove(e.touches[0].clientX); }
    function handleTouchEnd(e: TouchEvent) { onDragEnd(e.changedTouches[0].clientX); }

    progressSlider?.addEventListener('mousedown', (e: MouseEvent) => {
      e.preventDefault();
      initAudio();
      isDragging = true;
      progressSlider.classList.add('work-card__progress--dragging');
      onDragMove(e.clientX);
      document.addEventListener('mousemove', handleMouseMove);
      document.addEventListener('mouseup', handleMouseUp);
    });

    progressSlider?.addEventListener('touchstart', (e: TouchEvent) => {
      initAudio();
      isDragging = true;
      progressSlider.classList.add('work-card__progress--dragging');
      onDragMove(e.touches[0].clientX);
      document.addEventListener('touchmove', handleTouchMove, { passive: false });
      document.addEventListener('touchend', handleTouchEnd);
    }, { passive: true });
  });
</script>
