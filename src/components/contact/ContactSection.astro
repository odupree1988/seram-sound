---
import './ContactSection.css';
import ScrollReveal from '../ui/ScrollReveal.astro';
import { siteConfig } from '../../data/siteConfig';
---

<section class="contact" aria-labelledby="contact-heading">
  <div class="contact__inner">
    <ScrollReveal>
      <span class="section-label">Contact</span>
      <h2 class="section-heading contact__heading" id="contact-heading">{siteConfig.contactHeading}</h2>
      <p class="contact__subtext">{siteConfig.contactSubtext}</p>
    </ScrollReveal>

    <ScrollReveal delay={100}>
      <form class="contact__form" action="#" method="POST" data-contact-form novalidate>
        <div class="contact__form-row">
          <div class="contact__field">
            <label for="contact-name" class="contact__label">Name</label>
            <input type="text" id="contact-name" name="name" class="contact__input" required aria-required="true" autocomplete="name" />
            <span class="contact__error" id="contact-name-error" aria-live="polite"></span>
          </div>
          <div class="contact__field">
            <label for="contact-email" class="contact__label">Email</label>
            <input type="email" id="contact-email" name="email" class="contact__input" required aria-required="true" autocomplete="email" />
            <span class="contact__error" id="contact-email-error" aria-live="polite"></span>
          </div>
        </div>

        <div class="contact__form-row">
          <div class="contact__field">
            <label for="contact-type" class="contact__label">Project Type</label>
            <select id="contact-type" name="projectType" class="contact__input contact__select">
              <option value="">Select a type</option>
              <option value="short-film">Short Film</option>
              <option value="branded-content">Branded Content</option>
              <option value="documentary">Documentary</option>
              <option value="web-series">Web Series</option>
              <option value="trailer">Trailer</option>
              <option value="social-media">Social Media</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="contact__field">
            <label for="contact-budget" class="contact__label">Budget Range</label>
            <select id="contact-budget" name="budget" class="contact__input contact__select">
              <option value="">Select a range</option>
              <option value="under-1k">Under $1,000</option>
              <option value="1k-3k">$1,000 - $3,000</option>
              <option value="3k-5k">$3,000 - $5,000</option>
              <option value="5k-10k">$5,000 - $10,000</option>
              <option value="10k-plus">$10,000+</option>
            </select>
          </div>
        </div>

        <div class="contact__field">
          <label for="contact-deadline" class="contact__label">Deadline</label>
          <input type="date" id="contact-deadline" name="deadline" class="contact__input" />
        </div>

        <div class="contact__field">
          <label for="contact-message" class="contact__label">Project Description</label>
          <textarea id="contact-message" name="message" class="contact__input contact__textarea" rows="5" required aria-required="true" placeholder="Tell me about your project, creative direction, and timeline..."></textarea>
          <span class="contact__error" id="contact-message-error" aria-live="polite"></span>
        </div>

        <div class="contact__submit-wrapper">
          <button type="submit" class="btn--primary contact__submit">
            <span class="contact__submit-text">Send message</span>
            <svg class="contact__submit-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
            <span class="contact__submit-spinner" aria-hidden="true"></span>
          </button>
        </div>

        <div class="contact__status" role="status" aria-live="polite" data-form-status></div>
      </form>
    </ScrollReveal>

    <ScrollReveal delay={200}>
      <div class="contact__socials">
        <a href={`mailto:${siteConfig.email}`} class="contact__social-link" aria-label="Email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="0"/><path d="M22 4L12 13 2 4"/></svg>
          <span>{siteConfig.email}</span>
        </a>
      </div>
    </ScrollReveal>
  </div>
</section>

<script>
  function initContactForm() {
    const form = document.querySelector('[data-contact-form]') as HTMLFormElement;
    if (!form) return;
    const statusEl = form.querySelector('[data-form-status]') as HTMLElement;
    const submitBtn = form.querySelector('.contact__submit') as HTMLButtonElement;

    const validators: Record<string, (el: HTMLInputElement | HTMLTextAreaElement) => string> = {
      'contact-name': (el) => el.value.trim() ? '' : 'Name is required.',
      'contact-email': (el) => {
        if (!el.value.trim()) return 'Email is required.';
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim())) return 'Enter a valid email address.';
        return '';
      },
      'contact-message': (el) => el.value.trim() ? '' : 'Project description is required.',
    };

    function showError(fieldId: string, message: string) {
      const input = document.getElementById(fieldId) as HTMLInputElement;
      const errorEl = document.getElementById(`${fieldId}-error`);
      if (message) {
        input?.setAttribute('aria-invalid', 'true');
        input?.setAttribute('aria-describedby', `${fieldId}-error`);
        input?.classList.add('contact__input--error');
        if (errorEl) errorEl.textContent = message;
      } else {
        input?.removeAttribute('aria-invalid');
        input?.removeAttribute('aria-describedby');
        input?.classList.remove('contact__input--error');
        if (errorEl) errorEl.textContent = '';
      }
    }

    // Validate on blur
    Object.keys(validators).forEach((fieldId) => {
      const input = document.getElementById(fieldId) as HTMLInputElement;
      input?.addEventListener('blur', () => {
        const msg = validators[fieldId](input);
        showError(fieldId, msg);
      });
      // Clear error on input
      input?.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid') === 'true') {
          const msg = validators[fieldId](input);
          if (!msg) showError(fieldId, '');
        }
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Validate all fields
      let hasErrors = false;
      Object.keys(validators).forEach((fieldId) => {
        const input = document.getElementById(fieldId) as HTMLInputElement;
        const msg = validators[fieldId](input);
        showError(fieldId, msg);
        if (msg) hasErrors = true;
      });

      if (hasErrors) {
        const firstError = form.querySelector('[aria-invalid="true"]') as HTMLElement;
        firstError?.focus();
        return;
      }

      // Show loading state
      submitBtn.disabled = true;
      form.classList.add('contact__form--submitting');
      statusEl.textContent = '';
      statusEl.className = 'contact__status';

      try {
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        // Submit to configured endpoint
        // Replace this URL with your Formspree, Getform, or custom API endpoint
        const endpoint = form.getAttribute('action') || '#';

        if (endpoint === '#') {
          // No endpoint configured — show mailto fallback
          const subject = encodeURIComponent(`New project inquiry: ${data.projectType || 'General'}`);
          const body = encodeURIComponent(
            `Name: ${data.name}\nEmail: ${data.email}\nProject Type: ${data.projectType}\nBudget: ${data.budget}\nDeadline: ${data.deadline}\n\n${data.message}`
          );
          window.location.href = `mailto:hello@seramsound.com?subject=${subject}&body=${body}`;
          statusEl.textContent = 'Opening your email client...';
          statusEl.className = 'contact__status contact__status--success';
          return;
        }

        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          statusEl.textContent = 'Message sent! I\u2019ll be in touch soon.';
          statusEl.className = 'contact__status contact__status--success';
          form.reset();
          // Clear any lingering error states
          Object.keys(validators).forEach((fieldId) => showError(fieldId, ''));
        } else {
          throw new Error('Submission failed');
        }
      } catch {
        statusEl.textContent = 'Something went wrong. Please try again or email directly.';
        statusEl.className = 'contact__status contact__status--error';
      } finally {
        submitBtn.disabled = false;
        form.classList.remove('contact__form--submitting');
      }
    });
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>
