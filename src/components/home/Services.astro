---
import './Services.css';
import { siteConfig } from '../../data/siteConfig';

const services = siteConfig.serviceTypes;
const duplicated = [...services, ...services];
---

<section class="services" aria-label="Services">
  <div class="services__marquee" aria-hidden="true">
    <div class="services__track">
      {duplicated.map((service) => (
        <span class="services__item">
          <span class="services__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18V5l12-2v13"/>
              <circle cx="6" cy="18" r="3"/>
              <circle cx="18" cy="16" r="3"/>
            </svg>
          </span>
          {service}
        </span>
      ))}
    </div>
  </div>
</section>
