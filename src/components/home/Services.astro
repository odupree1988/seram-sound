---
import './Services.css';

const row1 = ['Short Film', 'Documentary', 'Branded Content', 'Web Series', 'Trailer', 'Social Media', 'Podcast', 'Commercial'];
const row2 = ['Title Sequence', 'Music Video', 'Animation', 'Sound Design', 'Underscore', 'Ambient', 'Orchestral', 'Electronic'];

// Duplicate 4x for seamless loop
const row1Items = [...row1, ...row1, ...row1, ...row1];
const row2Items = [...row2, ...row2, ...row2, ...row2];
---

<section class="marquee-section" aria-label="Services">
  <div class="marquee-section__row">
    <div class="marquee-track marquee-track--row1" aria-hidden="true">
      {row1Items.map((service) => (
        <span class="marquee-item">
          <svg class="marquee-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18V5l12-2v13"/>
            <circle cx="6" cy="18" r="3"/>
            <circle cx="18" cy="16" r="3"/>
          </svg>
          <span class="marquee-item__label">{service}</span>
        </span>
      ))}
    </div>
  </div>
  <div class="marquee-section__row">
    <div class="marquee-track marquee-track--row2" aria-hidden="true">
      {row2Items.map((service) => (
        <span class="marquee-item">
          <svg class="marquee-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18V5l12-2v13"/>
            <circle cx="6" cy="18" r="3"/>
            <circle cx="18" cy="16" r="3"/>
          </svg>
          <span class="marquee-item__label">{service}</span>
        </span>
      ))}
    </div>
  </div>
</section>
