---
import './HomeCTA.css';
import ScrollReveal from '../ui/ScrollReveal.astro';
import { siteConfig } from '../../data/siteConfig';
---

<section class="home-cta" aria-labelledby="home-cta-heading">
  <div class="home-cta__inner">
    <ScrollReveal>
      <h2 class="home-cta__heading" id="home-cta-heading">{siteConfig.contactHeading}</h2>
      <p class="home-cta__subtext">{siteConfig.contactSubtext}</p>
      <div class="home-cta__actions">
        <a href="/contact" class="btn--primary">
          Start a project
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
        </a>
        <div class="home-cta__divider" aria-hidden="true"></div>
        <a href={`mailto:${siteConfig.email}`} class="btn--secondary">
          Send an email
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </ScrollReveal>
  </div>
</section>
