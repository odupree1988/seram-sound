---
import './Hero.css';
---

<section class="hero" id="hero">
  <!-- Radial glow behind waveform -->
  <div class="hero__glow" aria-hidden="true"></div>

  <!-- Centered synth waveform — wide, flat, organic -->
  <div class="hero__waveform" aria-hidden="true" style="mask-image: linear-gradient(90deg, transparent 0%, black 8%, black 92%, transparent 100%); -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 8%, black 92%, transparent 100%)">
    {Array.from({ length: 260 }, (_, i) => {
      const pos = i / 260;
      const curve = 0.2 + 0.4 * Math.pow(Math.cos((pos - 0.5) * Math.PI), 2);
      const noise = (Math.random() - 0.5) * 0.15;
      const height = Math.max(0.08, Math.min(0.75, curve + noise));
      const duration = (3 + Math.random() * 4).toFixed(2);
      const delay = (Math.random() * 5).toFixed(2);
      return (
        <span
          class="hero__bar"
          style={`height: ${(height * 100).toFixed(1)}%; --bar-dur: ${duration}s; --bar-delay: ${delay}s`}
        />
      );
    })}
  </div>

  <!-- Centered content -->
  <div class="hero__content">
    <span class="hero__label">Original Scoring Studio</span>

    <h1 class="hero__name">
      <span class="hero__name-line hero__name-line--solid">SERAM</span>
      <span class="hero__name-line hero__name-line--outlined">SOUND</span>
    </h1>

    <div class="hero__accent-bar" aria-hidden="true"></div>

    <p class="hero__intro">Original music composed to picture for short film, branded content, and independent productions. One composer, direct collaboration, every note written by hand.</p>

    <div class="hero__ctas">
      <a href="/portfolio" class="btn--primary">
        Listen to the work
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
      </a>
      <div class="hero__cta-divider" aria-hidden="true"></div>
      <a href="/contact" class="btn--secondary">
        Start a project
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-text">Scroll</span>
    <span class="hero__scroll-line"></span>
  </div>
</section>
