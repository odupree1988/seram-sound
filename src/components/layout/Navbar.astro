---
import './Navbar.css';
import { siteConfig } from '../../data/siteConfig';
---

<nav class="navbar" id="navbar" aria-label="Main navigation">
  <div class="navbar__inner">
    <a href="/" class="navbar__brand" aria-label={`${siteConfig.name} - Home`}>
      <span class="navbar__dot" aria-hidden="true"></span>
      <span class="navbar__name">seram.sound</span>
    </a>

    <div class="navbar__links" id="navbar-links">
      {siteConfig.navLinks.map((link) => (
        <a href={link.href} class="navbar__link">{link.label}</a>
      ))}
      <a href="/contact" class="btn--nav">Get a Quote</a>
    </div>

    <button
      class="navbar__hamburger"
      id="navbar-hamburger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="navbar-mobile-overlay"
    >
      <span class="navbar__hamburger-line" aria-hidden="true"></span>
      <span class="navbar__hamburger-line" aria-hidden="true"></span>
      <span class="navbar__hamburger-line" aria-hidden="true"></span>
    </button>
  </div>

  <div class="navbar__overlay" id="navbar-mobile-overlay" aria-hidden="true">
    <div class="navbar__overlay-content">
      <a href="/" class="navbar__overlay-link">Home</a>
      {siteConfig.navLinks.map((link) => (
        <a href={link.href} class="navbar__overlay-link">{link.label}</a>
      ))}
      <a href="/contact" class="navbar__overlay-link">Get a Quote</a>
    </div>
  </div>
</nav>

<script>
  // Module-level refs, refreshed on each navigation so the once-bound
  // window/document listeners always act on the current page's elements.
  let navbar: HTMLElement | null = null;
  let hamburger: HTMLElement | null = null;
  let overlay: HTMLElement | null = null;
  let globalsBound = false;

  function onScroll() {
    if (window.scrollY > 20) {
      navbar?.classList.add('navbar--scrolled');
    } else {
      navbar?.classList.remove('navbar--scrolled');
    }
  }

  function onKeydown(e: KeyboardEvent) {
    if (e.key === 'Escape' && hamburger?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
    }
  }

  function openMenu() {
    hamburger?.setAttribute('aria-expanded', 'true');
    hamburger?.setAttribute('aria-label', 'Close menu');
    overlay?.setAttribute('aria-hidden', 'false');
    hamburger?.classList.add('navbar__hamburger--open');
    document.body.style.overflow = 'hidden';
    // Focus first link in overlay
    const firstLink = overlay?.querySelector('a') as HTMLElement;
    firstLink?.focus();
  }

  function closeMenu() {
    hamburger?.setAttribute('aria-expanded', 'false');
    hamburger?.setAttribute('aria-label', 'Open menu');
    overlay?.setAttribute('aria-hidden', 'true');
    hamburger?.classList.remove('navbar__hamburger--open');
    document.body.style.overflow = '';
    hamburger?.focus();
  }

  function initNavbar() {
    navbar = document.getElementById('navbar');
    hamburger = document.getElementById('navbar-hamburger');
    overlay = document.getElementById('navbar-mobile-overlay');

    // Reflect the current scroll position for the freshly-loaded page.
    onScroll();

    // Mobile menu toggle (bound to the fresh hamburger element)
    hamburger?.addEventListener('click', () => {
      const isOpen = hamburger!.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Focus trap inside overlay
    overlay?.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusable = overlay!.querySelectorAll('a, button') as NodeListOf<HTMLElement>;
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Close overlay on link click
    overlay?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Window/document listeners only need binding once for the session.
    if (!globalsBound) {
      globalsBound = true;
      window.addEventListener('scroll', onScroll);
      document.addEventListener('keydown', onKeydown);
    }
  }

  document.addEventListener('astro:page-load', initNavbar);
</script>
