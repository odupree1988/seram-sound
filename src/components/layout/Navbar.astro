---
import './Navbar.css';
import ThemeToggle from '../ui/ThemeToggle.astro';
import { siteConfig } from '../../data/siteConfig';
---

<nav class="navbar" id="navbar" aria-label="Main navigation">
  <div class="navbar__inner">
    <a href="/" class="navbar__brand" aria-label={`${siteConfig.name} - Home`}>
      <span class="navbar__dot" aria-hidden="true"></span>
      <span class="navbar__name">seram.sound</span>
    </a>

    <div class="navbar__links" id="navbar-links">
      {siteConfig.navLinks.map((link) => (
        <a href={link.href} class="navbar__link">{link.label}</a>
      ))}
      <a href="/contact" class="btn--nav">Get a Quote</a>
      <span class="navbar__divider" aria-hidden="true"></span>
      <ThemeToggle />
    </div>

    <button
      class="navbar__hamburger"
      id="navbar-hamburger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="navbar-mobile-overlay"
    >
      <span class="navbar__hamburger-line" aria-hidden="true"></span>
      <span class="navbar__hamburger-line" aria-hidden="true"></span>
      <span class="navbar__hamburger-line" aria-hidden="true"></span>
    </button>
  </div>

  <div class="navbar__overlay" id="navbar-mobile-overlay" aria-hidden="true">
    <div class="navbar__overlay-content">
      <a href="/" class="navbar__overlay-link">Home</a>
      {siteConfig.navLinks.map((link) => (
        <a href={link.href} class="navbar__overlay-link">{link.label}</a>
      ))}
      <a href="/contact" class="navbar__overlay-link">Get a Quote</a>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar');
  const hamburger = document.getElementById('navbar-hamburger');
  const overlay = document.getElementById('navbar-mobile-overlay');

  // Glass blur on scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar?.classList.add('navbar--scrolled');
    } else {
      navbar?.classList.remove('navbar--scrolled');
    }
  });

  function openMenu() {
    hamburger?.setAttribute('aria-expanded', 'true');
    hamburger?.setAttribute('aria-label', 'Close menu');
    overlay?.setAttribute('aria-hidden', 'false');
    hamburger?.classList.add('navbar__hamburger--open');
    document.body.style.overflow = 'hidden';
    // Focus first link in overlay
    const firstLink = overlay?.querySelector('a') as HTMLElement;
    firstLink?.focus();
  }

  function closeMenu() {
    hamburger?.setAttribute('aria-expanded', 'false');
    hamburger?.setAttribute('aria-label', 'Open menu');
    overlay?.setAttribute('aria-hidden', 'true');
    hamburger?.classList.remove('navbar__hamburger--open');
    document.body.style.overflow = '';
    hamburger?.focus();
  }

  // Mobile menu toggle
  hamburger?.addEventListener('click', () => {
    const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && hamburger?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
    }
  });

  // Focus trap inside overlay
  overlay?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const focusable = overlay.querySelectorAll('a, button') as NodeListOf<HTMLElement>;
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Close overlay on link click
  overlay?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      closeMenu();
    });
  });
</script>
